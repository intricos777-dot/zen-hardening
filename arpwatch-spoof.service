[Unit]
Description=ARP spoof watcher (arpwatch datafile collector)
Documentation=file://%h/Projects/zen-hardening/arpwatch-spoof-scan.sh
After=network-online.target
Wants=network-online.target

[Service]
# arpwatch 3.9 flags ONLY. It has no -a (exec hook), no -u, no -c, and wants
# -i INTERFACE rather than a positional argument. Getting this wrong is what
# made the earlier version exit 1 in a restart loop.
#
#   -F  stay in the foreground; systemd wants the process, not a fork
#   -i  interface (3.9 syntax)
#   -f  datafile the scanner reads
#   -D  arpdir: this build's compiled-in default is /usr/arpwatch, which does
#      not exist, so it logged a chdir warning and fell back to the working
#      directory. The package ships ethercodes.dat (the MAC vendor database) in
#      /var/lib/arpwatch, so without -D the vendor lookups in reports silently
#      resolve to nothing.
#   -P  pidfile, so the scan timer can SIGHUP this exact process
#   -s  no email reports; there is no MTA here and it would queue forever
#   -N  no bogon reports  -- important on a /8, where most traffic looks odd
#   -z  no 0.0.0.0 reports -- arpwatch(8) recommends this for busy DHCP networks
#
# DO NOT ADD -q. arpwatch(8) lists it in the synopsis [-CdFNpqsvzZ] and
# describes it, but the 3.9 binary REJECTS it and prints usage, then exits 1.
# Every other letter in that synopsis is accepted; -q is the sole exception,
# which makes the man page wrong rather than the flag obscure. Verified by
# running each letter. install-arpwatch-spoof.sh now parse-checks this command
# so a bad flag cannot ship again.
#
# arpwatch only writes arp.dat every 15 minutes (SIGNALS in arpwatch(8)), so
# the scan timer SIGHUPs this pid before reading. Without that the scanner would
# re-read the same stale file on every tick.
ExecStart=/usr/sbin/arpwatch -F -i wlo1 -f /var/lib/arpwatch/arp.dat -D /var/lib/arpwatch -P /run/arpwatch-spoof.pid -s -N -z
Restart=on-failure
RestartSec=30

# arpwatch chdir()s to its arpdir (/usr/arpwatch) at startup, which does not
# exist here, logs "chdir(...): No such file or directory" and falls back to the
# working directory. For a system unit that is /. Point it at the real state
# directory so the fallback is harmless and the warning stops.
WorkingDirectory=/var/lib/arpwatch
# Needs the raw socket only. Runs as root because pcap_bind needs it; the
# datafile is what the unprivileged scanner reads.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/arpwatch

[Install]
WantedBy=multi-user.target
